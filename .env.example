# Server Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security
SECRET_KEY=change_me_to_a_secure_random_64_character_hex_string
TOTP_ENCRYPTION_KEY=dGhpc19pc19hbl9leGFtcGxlXzMyX2J5dGVfa2V5PT0=
SESSION_COOKIE_NAME=auth_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=86400

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adaptive_auth_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptive_auth_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Network Monitoring & Trusted Proxy
TRUSTED_PROXIES=127.0.0.1,::1
ENABLE_SIMULATION_MODE=true
